<Module>
  <ModulePrefs title="Google.com"/>
  <Content type="html">
    <![CDATA[
<!DOCTYPE html>
<html lang="en-us">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/awaiblecomponent/575@main/style.css"/>

    <style>
      /* Disable focus outline on canvas */
      canvas:focus { outline: none; }

      html, body {
        padding: 0;
        margin: 0;
        overflow: hidden;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        -khtml-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        -webkit-tap-highlight-color: rgba(0,0,0,0);
        height: 100%;
        background: #000;
      }
    </style>
    <!-- Additional head modules -->
  </head>

  <body class="dark">
    <div id="unity-container" class="unity-desktop">
      <canvas id="unity-canvas" tabindex="-1"></canvas>
    </div>

    <div id="loading-cover" style="display:none;">
      <div id="unity-loading-bar">
        <div id="unity-logo">
          <img src="https://cdn.jsdelivr.net/gh/awaiblecomponent/575@main/logo.png"/>
        </div>

        <div id="unity-progress-bar-empty" style="display: none;">
          <div id="unity-progress-bar-full"></div>
        </div>

        <div class="spinner"></div>
      </div>
    </div>

    <!-- Unity loader & WASM-merge logic (ads removed) -->
    <script>
      (function() {
        const buildUrl = "https://cdn.jsdelivr.net/gh/awaiblecomponent/575@main/Build";
        const loaderUrl = buildUrl + "/zombieshooterdone.loader.js";

        const config = {
          dataUrl: buildUrl + "/zombieshooterdone.data.br",
          frameworkUrl: buildUrl + "/zombieshooterdone.framework.js",
          streamingAssetsUrl: "StreamingAssets",
          companyName: "OnHitDev",
          productName: "They Are Coming",
          productVersion: "1.19"
        };

        const wasmParts = [
          `${buildUrl}/zombieshooterdone.wasm.br.part0`,
          `${buildUrl}/zombieshooterdone.wasm.br.part1`,
          `${buildUrl}/zombieshooterdone.wasm.br.part2`,
          `${buildUrl}/zombieshooterdone.wasm.br.part3`
        ];

        async function fetchAndMergeWasm() {
          const parts = await Promise.all(wasmParts.map(url =>
            fetch(url).then(r => {
              if (!r.ok) throw new Error(`Failed to load ${url}`);
              return r.arrayBuffer();
            })
          ));

          const totalLength = parts.reduce((sum, p) => sum + p.byteLength, 0);
          const merged = new Uint8Array(totalLength);
          let offset = 0;
          for (const part of parts) {
            merged.set(new Uint8Array(part), offset);
            offset += part.byteLength;
          }

          // Using 'application/wasm+br' to reflect original Brotli parts; hosting must serve correct headers.
          const blob = new Blob([merged], { type: "application/wasm+br" });
          return URL.createObjectURL(blob);
        }

        // Auto-init: merge wasm parts, set codeUrl, then load loader and create Unity instance
        (async function initUnity() {
          try {
            const blobUrl = await fetchAndMergeWasm();
            config.codeUrl = blobUrl;

            const script = document.createElement("script");
            script.src = loaderUrl;
            script.onload = () => {
              createUnityInstance(document.querySelector("#unity-canvas"), config, (progress) => {
                const bar = document.querySelector("#unity-progress-bar-full");
                if (bar) bar.style.width = (progress * 100) + "%";
              }).then((unityInstance) => {
                window.myGameInstance = unityInstance;
                document.querySelector("#loading-cover").style.display = "none";
              }).catch(err => {
                console.error("Unity load failed:", err);
              });
            };
            document.body.appendChild(script);
          } catch (err) {
            console.error("Failed to prepare Unity build:", err);
            // Optionally show a simple error UI so it's visible in embeds
            const cover = document.querySelector("#loading-cover");
            if (cover) {
              cover.style.display = "";
              cover.innerHTML = '<div style="color:#fff;padding:20px;font-family:Arial, sans-serif;">Failed to load game. See console for details.</div>';
            }
          }
        })();
      })();
    </script>

    <!-- Ad-related markup and scripts intentionally removed -->

    <!-- Keep Yandex SDK placeholders & utility functions (non-ad) -->
    <script>
      const container = document.querySelector("#unity-container");
      const canvas = document.querySelector("#unity-canvas");
      const loadingCover = document.querySelector("#loading-cover");

      const canFullscreen = (function () {
        for (const key of [
          'exitFullscreen',
          'webkitExitFullscreen',
          'webkitCancelFullScreen',
          'mozCancelFullScreen',
          'msExitFullscreen'
        ]) {
          if (key in document) return true;
        }
        return false;
      })();

      if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
        if (container) container.className = "unity-mobile";
      }

      // Background while loading
      if (loadingCover) {
        loadingCover.style.background = "url('background.png') center / cover";
        loadingCover.style.display = "";
      }

      // Disable right-click
      document.addEventListener('contextmenu', event => event.preventDefault());

      function FocusGame() {
        window.focus();
        try { canvas.focus(); } catch(e) {}
      }

      window.addEventListener('pointerdown', FocusGame);
      window.addEventListener('touchstart', FocusGame);

      // Placeholder functions from original (ads/SDK disabled)
      let myGameInstance = null;
      let initGame = false;
      let nowFullAdOpen = false;

      function FullAdShow() {
        // No-op (ads removed)
        console.warn("FullAdShow called but ads are disabled in this build.");
      }

      function RewardedShow(rewardId) {
        // No-op
        console.warn("RewardedShow called but ads are disabled in this build.");
      }

      function SaveCloud() { console.warn("SaveCloud not implemented"); }
      function LoadCloud() { console.warn("LoadCloud not implemented"); return Promise.resolve("noData"); }
      function InitPlayer() { console.warn("InitPlayer not implemented"); return Promise.resolve("noData"); }
      function StickyAdActivity() { console.warn("StickyAdActivity not implemented"); }
      function Review() { console.warn("Review not implemented"); }
      function PromptShow() { console.warn("PromptShow not implemented"); }
      function InitLeaderboards() { console.warn("InitLeaderboards not implemented"); }
      function GetLeaderboardScores() { console.warn("GetLeaderboardScores not implemented"); }
      function SetLeaderboardScores() { console.warn("SetLeaderboardScores not implemented"); }
      function ConsumePurchase() { console.warn("ConsumePurchase not implemented"); }
      function ConsumePurchases() { console.warn("ConsumePurchases not implemented"); }
    </script>
  </body>
</html>
    ]]>
  </Content>
</Module>
