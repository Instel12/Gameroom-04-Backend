<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      color: #333;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }
    h1 {
      margin-bottom: 10px;
    }
    #game {
      display: grid;
      grid-template-columns: repeat(5, 50px);
      grid-gap: 5px;
      margin-bottom: 20px;
    }
    .cell {
      width: 50px;
      height: 50px;
      border: 2px solid #d3d6da;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      font-weight: bold;
      text-transform: uppercase;
      background-color: white;
    }
    .correct {
      background-color: #6aaa64;
      color: white;
      border-color: #6aaa64;
    }
    .present {
      background-color: #c9b458;
      color: white;
      border-color: #c9b458;
    }
    .absent {
      background-color: #787c7e;
      color: white;
      border-color: #787c7e;
    }
    #keyboard {
      display: grid;
      grid-template-columns: repeat(10, 40px);
      grid-gap: 5px;
      max-width: 420px;
      margin-top: 20px;
      justify-content: center;
    }
    .key {
      width: 40px;
      height: 50px;
      background-color: #d3d6da;
      color: black;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
      user-select: none;
    }
    .key.correct {
      background-color: #6aaa64;
      color: white;
    }
    .key.present {
      background-color: #c9b458;
      color: white;
    }
    .key.absent {
      background-color: #787c7e;
      color: white;
    }
    #message {
      margin-top: 10px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <h1>Wordle Unlimited</h1>
  <div id="game"></div>
  <div id="keyboard"></div>
  <p id="message"></p>

  <script>
    const WORD_LENGTH = 5;
    const MAX_TRIES = 6;
    const gameDiv = document.getElementById("game");
    const keyboardDiv = document.getElementById("keyboard");
    const message = document.getElementById("message");

    const qwertyRows = [
      "qwertyuiop",
      "asdfghjkl",
      "zxcvbnm"
    ];
    const keys = {};
    let wordList = [];
    let currentWord = "";
    let currentRow = 0;
    let currentCol = 0;
    let board = [];

    async function fetchWordList() {
      try {
        const response = await fetch("https://raw.githubusercontent.com/Instel12/Gameroom-04-Backend/refs/heads/main/words.txt");
        const text = await response.text();
        wordList = text.split("\n").map(w => w.trim().toLowerCase()).filter(w => w.length === 5);
        currentWord = wordList[Math.floor(Math.random() * wordList.length)];
        buildBoard();
        buildKeyboard();
      } catch (e) {
        message.textContent = "A critical error occored, please report this to Gameroom!";
      }
    }

    function buildBoard() {
      for (let r = 0; r < MAX_TRIES; r++) {
        board[r] = [];
        for (let c = 0; c < WORD_LENGTH; c++) {
          const cell = document.createElement("div");
          cell.className = "cell";
          gameDiv.appendChild(cell);
          board[r][c] = cell;
        }
      }
    }

    function buildKeyboard() {
      qwertyRows.forEach(row => {
        [...row].forEach(letter => {
          const key = document.createElement("div");
          key.className = "key";
          key.textContent = letter;
          key.onclick = () => handleKey(letter);
          keyboardDiv.appendChild(key);
          keys[letter] = key;
        });
        const spacer = document.createElement("div");
        spacer.style.gridColumn = "span 10";
        keyboardDiv.appendChild(spacer);
      });
    }

    function handleKey(key) {
      if (currentRow >= MAX_TRIES) return;

      if (key === "Backspace") {
        if (currentCol > 0) {
          currentCol--;
          board[currentRow][currentCol].textContent = "";
          message.textContent = "";
        }
        return;
      }

      if (/^[a-z]$/.test(key) && currentCol < WORD_LENGTH) {
        board[currentRow][currentCol].textContent = key;
        currentCol++;

        if (currentCol === WORD_LENGTH) {
          const guess = board[currentRow].map(cell => cell.textContent).join("").toLowerCase();
          if (wordList.includes(guess)) {
            checkGuess(guess);
            currentRow++;
            currentCol = 0;
          } else {
            message.textContent = `"${guess}" is not a valid word`;
          }
        }
      }
    }

    function checkGuess(guess) {
      const answer = currentWord.split("");
      const guessLetters = guess.split("");
      const result = Array(WORD_LENGTH).fill("absent");
      const letterCount = {};

      for (let letter of answer) {
        letterCount[letter] = (letterCount[letter] || 0) + 1;
      }

      for (let i = 0; i < WORD_LENGTH; i++) {
        if (guessLetters[i] === answer[i]) {
          result[i] = "correct";
          letterCount[guessLetters[i]]--;
        }
      }

      for (let i = 0; i < WORD_LENGTH; i++) {
        if (result[i] === "correct") continue;
        if (letterCount[guessLetters[i]]) {
          result[i] = "present";
          letterCount[guessLetters[i]]--;
        }
      }

      for (let i = 0; i < WORD_LENGTH; i++) {
        const cell = board[currentRow][i];
        const letter = guessLetters[i];
        cell.classList.add(result[i]);

        if (keys[letter]) {
          keys[letter].classList.remove("absent", "present", "correct");
          keys[letter].classList.add(result[i]);
        }
      }

      if (guess === currentWord) {
        message.textContent = "🎉 You got it! New word in 3s...";
        setTimeout(() => location.reload(), 3000);
      } else if (currentRow + 1 === MAX_TRIES) {
        message.textContent = `Out of tries! The word was "${currentWord.toUpperCase()}"`;
      }
    }

    document.addEventListener("keydown", e => {
      if (e.key === "Backspace") {
        handleKey("Backspace");
      } else if (/^[a-zA-Z]$/.test(e.key)) {
        handleKey(e.key.toLowerCase());
      }
    });

    fetchWordList();
  </script>
</body>
</html>
